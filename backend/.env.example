# RentProof backend — environment variables
# Copy this to .env and fill in real values. Never commit .env.

# -- LLM --
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK_1=gemini-2.0-flash
GEMINI_MODEL_FALLBACK_2=gemma-3-12b-it

# -- Server --
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# -- CORS (frontend dev server) --
FRONTEND_ORIGIN=http://localhost:5173

# -- Demo mode --
# When true, agent uses cached responses if LLM API fails (demo safety net)
USE_CACHED_FALLBACK=true
